<Window x:Class="Zeitfluss.TimeRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Erfassung prüfen" Width="570" Height="560" MinHeight="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#F3F4F7"
        FontFamily="Segoe UI Variable Text" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="RecoveryChoiceStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" Background="#D9FFFFFF" BorderBrush="{StaticResource GlassLine}" BorderThickness="1" CornerRadius="15" Padding="15">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#802878F0" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoft}" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" /><Setter TargetName="Chrome" Property="BorderThickness" Value="2" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30,26,30,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <Border Background="#FFF0DE" CornerRadius="10" Padding="9,5" HorizontalAlignment="Left">
                <TextBlock Text="PRÜFUNG EMPFOHLEN" Foreground="#A35C00" FontSize="10" FontWeight="SemiBold" />
            </Border>
            <TextBlock Text="Lief die Erfassung zu lange?" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBlock x:Name="ReasonText" TextWrapping="Wrap" Foreground="{StaticResource MutedInk}" Margin="0,7,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Background="#BFFFFFFF" BorderBrush="{StaticResource GlassLine}" BorderThickness="1" CornerRadius="15" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="GESTARTET" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedInk}" /><TextBlock x:Name="StartedText" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="OFFEN SEIT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedInk}" /><TextBlock x:Name="OpenDurationText" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="HEUTE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedInk}" /><TextBlock x:Name="TodayText" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock Text="Wähle die passende Korrektur" FontWeight="SemiBold" />
            <ListBox x:Name="SuggestionList" Grid.Row="2" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource RecoveryChoiceStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Foreground="{StaticResource MutedInk}" FontSize="12" Margin="0,4,16,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding EndLabel}" FontFamily="Segoe UI Variable Display" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding CreditLabel}" Foreground="{StaticResource MutedInk}" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Du behältst immer die Kontrolle über die gespeicherte Zeit." Foreground="{StaticResource MutedInk}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,18,0" />
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Weiterlaufen lassen" Click="KeepRunning_Click" />
            <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Korrektur übernehmen" Click="Apply_Click" />
        </Grid>
    </Grid>
</Window>
