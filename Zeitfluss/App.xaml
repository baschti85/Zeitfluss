<Application x:Class="Zeitfluss.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Ink" Color="#171719" /><SolidColorBrush x:Key="MutedInk" Color="#6E7180" />
        <SolidColorBrush x:Key="Line" Color="#E4E6EC" /><SolidColorBrush x:Key="Surface" Color="#F5F6F9" />
        <SolidColorBrush x:Key="Accent" Color="#2878F0" /><SolidColorBrush x:Key="AccentSoft" Color="#E7F0FF" />
        <SolidColorBrush x:Key="Positive" Color="#16875D" /><SolidColorBrush x:Key="PositiveSoft" Color="#E2F5EC" />
        <SolidColorBrush x:Key="Negative" Color="#D14B55" /><SolidColorBrush x:Key="Warning" Color="#E99A2E" /><SolidColorBrush x:Key="WarningSoft" Color="#FFF1D9" />
        <SolidColorBrush x:Key="GlassLine" Color="#A8FFFFFF" /><SolidColorBrush x:Key="GlassCard" Color="#BFFFFFFF" />
        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Text" /></Style>
        <Style TargetType="Button" x:Key="BaseButton">
            <Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" /><Setter Property="Padding" Value="14,7" /><Setter Property="MinHeight" Value="40" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid x:Name="VisualRoot" RenderTransformOrigin="0.5,0.5">
                    <Border x:Name="FocusRing" Margin="-3" CornerRadius="14" BorderBrush="Transparent" BorderThickness="2" />
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" TextElement.FontFamily="Segoe UI Variable Text" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.86" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="VisualRoot" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98" /></Setter.Value></Setter></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="#802878F0" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="VisualRoot" Property="Opacity" Value="0.38" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource BaseButton}"><Setter Property="Background" Value="{StaticResource Ink}" /><Setter Property="Foreground" Value="White" /></Style>
        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource BaseButton}"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="{StaticResource Line}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="{StaticResource Ink}" /></Style>
        <Style TargetType="Button" x:Key="GhostButton" BasedOn="{StaticResource BaseButton}"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource MutedInk}" /><Setter Property="Padding" Value="8,5" /><Setter Property="MinHeight" Value="32" /></Style>
        <Style TargetType="Button" x:Key="CompactActionButton" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="44" /><Setter Property="Height" Value="44" /><Setter Property="MinHeight" Value="44" /><Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="#2B2B30" /><Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid x:Name="VisualRoot" RenderTransformOrigin="0.5,0.5">
                    <Border x:Name="FocusRing" Margin="-2" CornerRadius="15" BorderBrush="Transparent" BorderThickness="2" />
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="13" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#3A3A40" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="VisualRoot" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96" /></Setter.Value></Setter></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="#B3FFFFFF" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="VisualRoot" Property="Opacity" Value="0.32" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Button" x:Key="CompactStopButton" BasedOn="{StaticResource CompactActionButton}"><Setter Property="Background" Value="#302426" /><Setter Property="Foreground" Value="#F2A4A8" /></Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" /><Setter Property="FontSize" Value="14" /><Setter Property="Padding" Value="11,9" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#A9A9B0" /><Setter TargetName="Chrome" Property="Background" Value="White" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Application.Resources>
</Application>
