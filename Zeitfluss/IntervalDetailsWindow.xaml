<Window x:Class="Zeitfluss.IntervalDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Zeitfluss"
        Title="Zeitfluss Details"
        Width="980" Height="650" MinWidth="840" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#F4F4F6"
        FontFamily="Segoe UI Variable Text">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText" Foreground="{StaticResource MutedInk}" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel Margin="0,0,26,0">
                    <TextBlock Text="ROHZEIT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedInk}" HorizontalAlignment="Right" />
                    <TextBlock x:Name="RawActualText" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource MutedInk}" Margin="0,4,0,0" HorizontalAlignment="Right" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="ANGERECHNET" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedInk}" HorizontalAlignment="Right" />
                    <TextBlock x:Name="ActualText" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0" HorizontalAlignment="Right" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Jeder Block entspricht einer einzelnen Erfassung. Pausen bleiben als freie Bereiche sichtbar."
                       Foreground="{StaticResource MutedInk}" FontSize="12" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="18" Height="7" CornerRadius="4" Background="#D9DDE5" Margin="0,0,6,0" />
                <TextBlock Text="Rohzeit" Foreground="{StaticResource MutedInk}" FontSize="11" VerticalAlignment="Center" />
                <Border Width="18" Height="11" CornerRadius="5" Background="{StaticResource Accent}" Margin="16,0,6,0" />
                <TextBlock Text="Angerechnet" Foreground="{StaticResource MutedInk}" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="#BFFFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="8">
            <Grid>
            <ListBox x:Name="DetailsList"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#E9EAF0" BorderThickness="1" CornerRadius="14" Padding="16" Margin="2,2,2,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Date}" FontWeight="SemiBold" FontSize="14" />
                                        <Border Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="8,3" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding CountLabel}" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RawTotalLabel}" Foreground="{StaticResource MutedInk}" FontSize="11" />
                                        <TextBlock Text="  →  " Foreground="#B0B3BE" FontSize="11" />
                                        <TextBlock Text="{Binding CreditedTotalLabel}" Foreground="{StaticResource Ink}" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>

                                <Grid Height="24" Margin="0,14,0,0" ClipToBounds="True">
                                    <Border Background="#F0F1F4" CornerRadius="8" Height="14" VerticalAlignment="Center" />
                                    <Grid IsHitTestVisible="False" Opacity="0.75">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="1" BorderBrush="#D8DAE2" BorderThickness="1,0,0,0" />
                                        <Border Grid.Column="2" BorderBrush="#D8DAE2" BorderThickness="1,0,0,0" />
                                        <Border Grid.Column="3" BorderBrush="#D8DAE2" BorderThickness="1,0,0,0" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Intervals}" IsHitTestVisible="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><local:IntervalTimelinePanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="local:IntervalTimelinePanel.StartMinute" Value="{Binding RawStartMinute}" />
                                                <Setter Property="local:IntervalTimelinePanel.EndMinute" Value="{Binding RawEndMinute}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><Border Height="8" VerticalAlignment="Center" Background="#C7CBD5" CornerRadius="4" /></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Intervals}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><local:IntervalTimelinePanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="local:IntervalTimelinePanel.StartMinute" Value="{Binding CreditedStartMinute}" />
                                                <Setter Property="local:IntervalTimelinePanel.EndMinute" Value="{Binding CreditedEndMinute}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="14" VerticalAlignment="Center" Background="{StaticResource Accent}" CornerRadius="6" ToolTip="{Binding TimelineToolTip}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <Grid Margin="0,3,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="00" Foreground="#9A9DA9" FontSize="9" />
                                    <TextBlock Grid.Column="1" Text="06" Foreground="#9A9DA9" FontSize="9" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="12" Foreground="#9A9DA9" FontSize="9" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="18" Foreground="#9A9DA9" FontSize="9" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="24" Foreground="#9A9DA9" FontSize="9" HorizontalAlignment="Right" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Intervals}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F7F8FA" CornerRadius="11" Padding="12,9" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="82" />
                                                        <ColumnDefinition Width="82" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CreditedRangeLabel}" FontSize="13" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding RawRangeLabel}" Foreground="{StaticResource MutedInk}" FontSize="11" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding CreditedDurationLabel}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                        <TextBlock Text="{Binding RoundingLabel}" Foreground="{StaticResource MutedInk}" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Foreground="{StaticResource Ink}"
                                                            Content="Ändern" Margin="8,0,0,0" Click="Edit_Click"
                                                            ToolTip="Beginn und Ende bearbeiten" />
                                                    <Button Grid.Column="3" Style="{StaticResource GhostButton}" Foreground="{StaticResource Negative}"
                                                            Content="Löschen" Margin="4,0,0,0" Click="Delete_Click"
                                                            ToolTip="Diese Erfassung löschen" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
                <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="21" Background="#EEF1F6" HorizontalAlignment="Center">
                        <TextBlock Text="○" Foreground="{StaticResource MutedInk}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Keine Erfassungen in diesem Zeitraum" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="Sobald Arbeitszeit erfasst wurde, erscheint sie hier auf der Zeitleiste." Foreground="{StaticResource MutedInk}" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="UndoPanel" Grid.Row="3" Visibility="Collapsed" Background="#F0171719" CornerRadius="12" Padding="14,10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✓" Foreground="#9AE0BE" FontSize="14" FontWeight="SemiBold" Margin="0,0,9,0" />
                    <TextBlock x:Name="UndoMessageText" Foreground="White" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Foreground="White" Content="Rückgängig" MinHeight="30" Padding="10,3" Click="UndoDelete_Click" />
            </Grid>
        </Border>

        <Button Grid.Row="4" HorizontalAlignment="Right" Margin="0,16,0,0" Style="{StaticResource SecondaryButton}" Content="Schließen" Click="Close_Click" />
    </Grid>
</Window>
