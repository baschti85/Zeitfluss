<Window x:Class="Zeitfluss.IntervalDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zeitfluss Details" Width="900" Height="500" MinWidth="820" MinHeight="380" WindowStartupLocation="CenterOwner" Background="#F4F4F6" FontFamily="Segoe UI Variable Text">
    <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock x:Name="TitleText" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" /><TextBlock x:Name="SubtitleText" Foreground="{StaticResource MutedInk}" Margin="0,6,0,0" /></StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="IST" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedInk}" HorizontalAlignment="Right" /><TextBlock x:Name="ActualText" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
        </Grid>
        <TextBlock Grid.Row="1" Text="Gerundete Zeiten sind die angerechneten Zeiten. Die Rohzeit steht im Hinweis." Foreground="{StaticResource MutedInk}" FontSize="12" Margin="0,20,0,10" />
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="8">
            <ListView x:Name="DetailsList" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Ink}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View><GridView>
                    <GridViewColumn Header="DATUM" Width="120" DisplayMemberBinding="{Binding Date}" /><GridViewColumn Header="BEGINN" Width="82" DisplayMemberBinding="{Binding Start}" />
                    <GridViewColumn Header="ENDE" Width="82" DisplayMemberBinding="{Binding End}" /><GridViewColumn Header="ZEIT" Width="72" DisplayMemberBinding="{Binding Duration}" />
                    <GridViewColumn Header="HINWEIS" Width="260" DisplayMemberBinding="{Binding Hint}" />
                    <GridViewColumn Header="" Width="92"><GridViewColumn.CellTemplate><DataTemplate><Button Style="{StaticResource GhostButton}" Foreground="{StaticResource Ink}" Content="Ändern" Click="Edit_Click" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                    <GridViewColumn Header="" Width="52"><GridViewColumn.CellTemplate><DataTemplate><Button Style="{StaticResource GhostButton}" Foreground="{StaticResource Negative}" Content="×" FontSize="16" ToolTip="Erfassung löschen" Click="Delete_Click" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                </GridView></ListView.View>
            </ListView>
        </Border>
        <Button Grid.Row="3" HorizontalAlignment="Right" Margin="0,16,0,0" Style="{StaticResource SecondaryButton}" Content="Schließen" Click="Close_Click" />
    </Grid>
</Window>
