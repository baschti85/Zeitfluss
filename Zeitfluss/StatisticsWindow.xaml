<Window x:Class="Zeitfluss.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Zeitfluss Statistik"
        Width="1000"
        Height="870"
        MinWidth="900"
        MinHeight="760"
        WindowStartupLocation="CenterOwner"
        Background="#F4F4F6"
        FontFamily="Segoe UI Variable Text">
    <Window.Resources>
        <Style x:Key="InsightCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="PeriodOverviewButton" TargetType="Button">
            <Setter Property="Height" Value="49" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="5,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="#F0F1F4" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="VisualRoot" RenderTransformOrigin="0.5,0.5">
                            <Border x:Name="FocusRing"
                                    Margin="-2"
                                    CornerRadius="11"
                                    BorderBrush="Transparent"
                                    BorderThickness="2" />
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#702878F0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="VisualRoot" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="#902878F0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="VisualRoot" Property="Opacity" Value="0.30" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="330" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Arbeitszeit" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Muster erkennen, Saldo verstehen und Zeiten präzise prüfen."
                           Foreground="{StaticResource MutedInk}" Margin="0,6,0,0" />
            </StackPanel>
            <Button Grid.Column="1"
                    Style="{StaticResource PrimaryButton}"
                    Content="CSV exportieren"
                    Click="Export_Click"
                    automation:AutomationProperties.Name="Arbeitszeiten als CSV exportieren" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,22,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition /><ColumnDefinition Width="12" />
                <ColumnDefinition /><ColumnDefinition Width="12" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="16"
                    automation:AutomationProperties.Name="Ist-Zeit gesamt">
                <StackPanel>
                    <TextBlock Text="IST GESAMT" Foreground="{StaticResource MutedInk}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock x:Name="TotalActualText" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="16"
                    automation:AutomationProperties.Name="Soll-Zeit gesamt">
                <StackPanel>
                    <TextBlock Text="SOLL GESAMT" Foreground="{StaticResource MutedInk}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock x:Name="TotalTargetText" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Background="White" CornerRadius="14" Padding="16"
                    automation:AutomationProperties.Name="Fortlaufender Gesamtsaldo">
                <StackPanel>
                    <TextBlock Text="SALDO" Foreground="{StaticResource MutedInk}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock x:Name="TotalBalanceText" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="0.92*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="PeriodOverviewCard"
                    Grid.Column="0"
                    Style="{StaticResource InsightCard}"
                    automation:AutomationProperties.Name="Dynamische Zeitübersicht"
                    automation:AutomationProperties.HelpText="Die Darstellung folgt der ausgewählten Auswertung und kann vollständig gescrollt werden.">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="OverviewTitleText" Text="Tagesverlauf" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="OverviewSubtitleText" Text="Alle Tage seit Beginn – nach unten zum aktuellen Zeitraum."
                                       Foreground="{StaticResource MutedInk}" FontSize="11" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                            <TextBlock x:Name="OverviewRangeText"
                                       Foreground="{StaticResource MutedInk}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <Button x:Name="LatestOverviewButton"
                                    Style="{StaticResource GhostButton}"
                                    Content="Aktuell"
                                    Height="30"
                                    Padding="9,0"
                                    Click="LatestOverview_Click"
                                    ToolTip="Zum neuesten Zeitraum springen"
                                    automation:AutomationProperties.Name="Zum neuesten Zeitraum springen" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="PeriodOverviewScroll"
                                  Grid.Row="1"
                                  Margin="0,10,0,7"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Visible"
                                  CanContentScroll="False"
                                  PanningMode="VerticalOnly"
                                  ScrollChanged="PeriodOverviewScroll_ScrollChanged"
                                  automation:AutomationProperties.Name="Scrollbare Periodenübersicht">
                        <Grid x:Name="PeriodOverviewHost" Margin="0,0,6,0" />
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Width="9" Height="9" CornerRadius="3" Background="#E6E8ED" Margin="0,0,5,0" />
                        <TextBlock Text="frei" Foreground="{StaticResource MutedInk}" FontSize="10" Margin="0,0,12,0" />
                        <Border Width="9" Height="9" CornerRadius="3" Background="#F0B7BA" Margin="0,0,5,0" />
                        <TextBlock Text="unter Soll" Foreground="{StaticResource MutedInk}" FontSize="10" Margin="0,0,12,0" />
                        <Border Width="9" Height="9" CornerRadius="3" Background="#82C5A9" Margin="0,0,5,0" />
                        <TextBlock Text="im Plus" Foreground="{StaticResource MutedInk}" FontSize="10" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource InsightCard}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="BalanceChartTitleText" Text="Fortlaufender Saldo" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="BalanceChartRangeText"
                                       Foreground="{StaticResource MutedInk}" FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="#F1F3F7" CornerRadius="10" Padding="9,5">
                            <TextBlock x:Name="BalanceChartCurrentText" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <Canvas x:Name="BalanceChartCanvas"
                            Grid.Row="1"
                            Margin="0,14,0,0"
                            ClipToBounds="True"
                            SizeChanged="BalanceChartCanvas_SizeChanged"
                            automation:AutomationProperties.Name="Kurve des fortlaufenden Zeitsaldos für den gewählten Zeitraum" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="DayButton" Style="{StaticResource GhostButton}" Content="Tage" Padding="15,8"
                        Click="Day_Click" automation:AutomationProperties.Name="Auswertung nach Tagen" />
                <Button x:Name="WeekButton" Style="{StaticResource SecondaryButton}" Content="Wochen" Padding="15,8"
                        Click="Week_Click" automation:AutomationProperties.Name="Auswertung nach Wochen" />
                <Button x:Name="MonthButton" Style="{StaticResource GhostButton}" Content="Monate" Padding="15,8"
                        Click="Month_Click" automation:AutomationProperties.Name="Auswertung nach Monaten" />
                <Button x:Name="YearButton" Style="{StaticResource GhostButton}" Content="Jahre" Padding="15,8"
                        Click="Year_Click" automation:AutomationProperties.Name="Auswertung nach Jahren" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="Präzise Detailansicht" Foreground="{StaticResource MutedInk}"
                       FontSize="11" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="4" Margin="0,12,0,0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="8">
            <ListView x:Name="PeriodList"
                      BorderThickness="0"
                      Background="Transparent"
                      Foreground="{StaticResource Ink}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      automation:AutomationProperties.Name="Präzise Arbeitszeitauswertung">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ZEITRAUM" Width="220" DisplayMemberBinding="{Binding Label}" />
                        <GridViewColumn Header="SOLL" Width="110" DisplayMemberBinding="{Binding Target}" />
                        <GridViewColumn Header="IST" Width="110" DisplayMemberBinding="{Binding Actual}" />
                        <GridViewColumn Header="DIFFERENZ" Width="120" DisplayMemberBinding="{Binding Balance}" />
                        <GridViewColumn Header="SALDO GESAMT" Width="135" DisplayMemberBinding="{Binding Cumulative}" />
                        <GridViewColumn Header="" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GhostButton}"
                                            Content="Details"
                                            Click="Details_Click"
                                            automation:AutomationProperties.Name="Zeiterfassungen im Zeitraum anzeigen" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock Grid.Row="5" x:Name="ExportStatusText" Foreground="{StaticResource Positive}"
                   FontSize="12" Margin="3,10,0,0" />
    </Grid>
</Window>
