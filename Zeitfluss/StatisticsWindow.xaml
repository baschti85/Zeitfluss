<Window x:Class="Zeitfluss.StatisticsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zeitfluss Statistik" Width="820" Height="610" MinWidth="720" MinHeight="520" WindowStartupLocation="CenterOwner" Background="#F4F4F6" FontFamily="Segoe UI Variable Text">
    <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Arbeitszeit" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Soll, Ist und dein fortlaufender Zeitsaldo." Foreground="{StaticResource MutedInk}" Margin="0,6,0,0" /></StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="CSV exportieren" Click="Export_Click" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,24,0,18"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="16"><StackPanel><TextBlock Text="IST GESAMT" Foreground="{StaticResource MutedInk}" FontSize="10" FontWeight="SemiBold" /><TextBlock x:Name="TotalActualText" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border>
            <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="16"><StackPanel><TextBlock Text="SOLL GESAMT" Foreground="{StaticResource MutedInk}" FontSize="10" FontWeight="SemiBold" /><TextBlock x:Name="TotalTargetText" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border>
            <Border Grid.Column="4" Background="White" CornerRadius="14" Padding="16"><StackPanel><TextBlock Text="SALDO" Foreground="{StaticResource MutedInk}" FontSize="10" FontWeight="SemiBold" /><TextBlock x:Name="TotalBalanceText" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="DayButton" Style="{StaticResource GhostButton}" Content="Tage" Padding="15,8" Click="Day_Click" />
            <Button x:Name="WeekButton" Style="{StaticResource SecondaryButton}" Content="Wochen" Padding="15,8" Click="Week_Click" />
            <Button x:Name="MonthButton" Style="{StaticResource GhostButton}" Content="Monate" Padding="15,8" Click="Month_Click" />
            <Button x:Name="YearButton" Style="{StaticResource GhostButton}" Content="Jahre" Padding="15,8" Click="Year_Click" />
        </StackPanel>
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="8">
            <ListView x:Name="PeriodList" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Ink}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View><GridView>
                    <GridViewColumn Header="ZEITRAUM" Width="190" DisplayMemberBinding="{Binding Label}" /><GridViewColumn Header="SOLL" Width="105" DisplayMemberBinding="{Binding Target}" />
                    <GridViewColumn Header="IST" Width="105" DisplayMemberBinding="{Binding Actual}" /><GridViewColumn Header="DIFFERENZ" Width="115" DisplayMemberBinding="{Binding Balance}" />
                    <GridViewColumn Header="SALDO GESAMT" Width="125" DisplayMemberBinding="{Binding Cumulative}" />
                    <GridViewColumn Header="" Width="90"><GridViewColumn.CellTemplate><DataTemplate><Button Style="{StaticResource GhostButton}" Content="Details" Click="Details_Click" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                </GridView></ListView.View>
            </ListView>
        </Border>
        <TextBlock Grid.Row="4" x:Name="ExportStatusText" Foreground="{StaticResource Positive}" FontSize="12" Margin="3,12,0,0" />
    </Grid>
</Window>
