<Window x:Class="Zeitfluss.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen" Width="500" Height="740" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F4F4F6" FontFamily="Segoe UI Variable Text">
    <Grid Margin="30">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Grid.Row="0"><TextBlock Text="Einstellungen" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Arbeitszeit, Sollzeit und Datensicherung." Foreground="{StaticResource MutedInk}" Margin="0,6,0,0" /></StackPanel>

        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,24,0,0">
            <StackPanel Margin="0,0,7,0">
                <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,14">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Wochenstunden" FontWeight="SemiBold" /><TextBlock Text="Gesamtes Soll pro Woche" FontSize="12" Foreground="{StaticResource MutedInk}" Margin="0,3,0,0" /></StackPanel>
                        <TextBox x:Name="WeeklyText" Grid.Column="1" TextAlignment="Right" />
                    </Grid>
                </Border>

                <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="18">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="Regelarbeitszeit" FontWeight="SemiBold" Margin="0,0,0,13" /><TextBlock Grid.Column="1" Text="Stunden" Foreground="{StaticResource MutedInk}" FontSize="12" TextAlignment="Right" />
                        <TextBlock Grid.Row="1" Text="Montag" VerticalAlignment="Center" /><TextBox x:Name="MondayText" Grid.Row="1" Grid.Column="1" TextAlignment="Right" Margin="0,2" />
                        <TextBlock Grid.Row="2" Text="Dienstag" VerticalAlignment="Center" /><TextBox x:Name="TuesdayText" Grid.Row="2" Grid.Column="1" TextAlignment="Right" Margin="0,2" />
                        <TextBlock Grid.Row="3" Text="Mittwoch" VerticalAlignment="Center" /><TextBox x:Name="WednesdayText" Grid.Row="3" Grid.Column="1" TextAlignment="Right" Margin="0,2" />
                        <TextBlock Grid.Row="4" Text="Donnerstag" VerticalAlignment="Center" /><TextBox x:Name="ThursdayText" Grid.Row="4" Grid.Column="1" TextAlignment="Right" Margin="0,2" />
                        <TextBlock Grid.Row="5" Text="Freitag" VerticalAlignment="Center" /><TextBox x:Name="FridayText" Grid.Row="5" Grid.Column="1" TextAlignment="Right" Margin="0,2" />
                        <TextBlock Grid.Row="6" Text="Samstag" VerticalAlignment="Center" /><TextBox x:Name="SaturdayText" Grid.Row="6" Grid.Column="1" TextAlignment="Right" Margin="0,2" />
                        <TextBlock Grid.Row="7" Text="Sonntag" VerticalAlignment="Center" /><TextBox x:Name="SundayText" Grid.Row="7" Grid.Column="1" TextAlignment="Right" Margin="0,2" />
                    </Grid>
                </Border>

                <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Datensicherung" FontWeight="SemiBold" />
                        <TextBlock Text="Vollständige Sicherung für einen PC-Wechsel. CSV-Dateien bleiben reine Auswertungen." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedInk}" Margin="0,4,0,13" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource SecondaryButton}" Content="Sicherung importieren" Click="ImportBackup_Click" />
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Sicherung exportieren" Click="ExportBackup_Click" />
                        </Grid>
                        <TextBlock x:Name="BackupStatusText" Foreground="{StaticResource Positive}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="ValidationText" Grid.Row="2" Foreground="{StaticResource Negative}" FontSize="12" TextWrapping="Wrap" MinHeight="28" Margin="2,10,0,3" />
        <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Dezimalwerte wie 7,5 sind möglich." VerticalAlignment="Center" Foreground="{StaticResource MutedInk}" FontSize="11" />
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Abbrechen" Click="Cancel_Click" />
            <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Speichern" Click="Save_Click" />
        </Grid>
    </Grid>
</Window>
